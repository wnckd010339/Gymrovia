# Database
DB_URL=jdbc:mysql://<rds-endpoint>:3306/gym_management
DB_USERNAME=<database-username>
DB_PASSWORD=<database-password>
FLYWAY_BASELINE_ON_MIGRATE=false

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>

# Toss Payments test environment
TOSS_CLIENT_KEY=<toss-test-client-key>
TOSS_SECRET_KEY=<toss-test-secret-key>
TOSS_SUCCESS_URL=https://gymrovia.com/member/payments/success
TOSS_FAIL_URL=https://gymrovia.com/member/payments/fail
TOSS_CONNECT_TIMEOUT=3s
TOSS_READ_TIMEOUT=10s

# Attendance QR
ATTENDANCE_QR_CENTER_CODE=GYMROVIA_MAIN
ATTENDANCE_QR_CENTER_NAME=Gymrovia
ATTENDANCE_QR_PUBLIC_BASE_URL=https://gymrovia.com
